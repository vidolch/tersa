{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tersa benchmark run record",
  "description": "One agent run of one task in one arm. One JSON file per run in results/<arm>/<task>/<run>.json.",
  "type": "object",
  "required": [
    "arm",
    "task",
    "run",
    "chained",
    "model",
    "harness",
    "usage",
    "agent",
    "acceptance",
    "costUsd"
  ],
  "properties": {
    "arm": {
      "enum": [
        "A-ts-baseline",
        "B-ts-query",
        "B2-ts-query-shell",
        "C-tersa-lang",
        "D-ts-bundle", "F-ts-exhaustive", "G-ts-agreement", "H-ts-contracts", "I-ts-gencontracts"
      ]
    },
    "task": {
      "type": "string",
      "pattern": "^[A-Z]+\\d+$",
      "description": "task id, unique across suites (T* urlshort, AB* actual)"
    },
    "run": {
      "type": "integer",
      "minimum": 1
    },
    "chained": {
      "type": "boolean",
      "description": "true if started from the previous task's agent output instead of a reference state"
    },
    "startState": {
      "type": "string",
      "description": "reference snapshot id or 'scaffold'"
    },
    "specSha256": {
      "type": "string",
      "description": "hash of the spec file, proves specs were identical"
    },
    "model": {
      "type": "string"
    },
    "modelOptions": {
      "description": "Model settings varied by an experiment; absent = SDK defaults (adaptive thinking, default effort).",
      "type": "object",
      "properties": {
        "effort": { "enum": ["low", "medium", "high", "xhigh", "max"] },
        "thinking": { "enum": ["adaptive", "disabled"] }
      },
      "additionalProperties": false
    },
    "harness": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "usage": {
      "type": "object",
      "description": "Token totals across the whole run, by billing class",
      "required": [
        "inputUncached",
        "cacheRead",
        "cacheWrite",
        "output"
      ],
      "properties": {
        "inputUncached": {
          "type": "integer"
        },
        "cacheRead": {
          "type": "integer"
        },
        "cacheWrite": {
          "type": "integer"
        },
        "output": {
          "type": "integer"
        },
        "toolResultTokens": {
          "type": "integer",
          "description": "P6: tokens that came from tool output"
        },
        "contextOverheadTokens": {
          "type": "integer",
          "description": "skills/docs injected for the arm (C: language skill)"
        }
      }
    },
    "agent": {
      "type": "object",
      "required": [
        "turns",
        "toolCalls",
        "wallMs"
      ],
      "properties": {
        "turns": {
          "type": "integer"
        },
        "toolCalls": {
          "type": "integer"
        },
        "toolCallsByName": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "fileReads": {
          "type": "integer"
        },
        "repeatReads": {
          "type": "integer",
          "description": "P1/P8: reads of a file or symbol already read in this run"
        },
        "failedEdits": {
          "type": "integer",
          "description": "P4"
        },
        "compileFailures": {
          "type": "integer",
          "description": "P2"
        },
        "testRuns": {
          "type": "integer"
        },
        "compactions": {
          "type": "integer",
          "description": "P8"
        },
        "wallMs": {
          "type": "integer"
        },
        "completed": {
          "type": "boolean",
          "description": "false if the agent hit a turn/token cap"
        },
        "networkCommands": {
          "type": "integer",
          "description": "Bash commands reaching the network; nonzero runs need review"
        },
        "apiRetries": {
          "type": "integer"
        },
        "apiRetryWaitMs": {
          "type": "integer"
        },
        "turnsToFirstEdit": {
          "type": [
            "integer",
            "null"
          ],
          "description": "main-thread turn of the first Edit/Write"
        },
        "shellQueryCalls": {
          "type": "integer"
        }
      }
    },
    "acceptance": {
      "type": "object",
      "required": [
        "passed",
        "rules"
      ],
      "properties": {
        "passed": {
          "type": "boolean",
          "description": "all rules of this task and earlier tasks pass"
        },
        "rules": {
          "type": "object",
          "description": "keyed by 'T1 R3', 'AB2 R4', 'AB2 regression' etc.",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "regressionFailures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "perf": {
      "type": "object",
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "p50Ms": {
          "type": "number"
        },
        "p95Ms": {
          "type": "number"
        },
        "p99Ms": {
          "type": "number"
        },
        "rps": {
          "type": "number"
        },
        "errorRate": {
          "type": "number"
        }
      }
    },
    "costUsd": {
      "type": "number",
      "description": "computed from usage and the model's price table at run time"
    },
    "provider": {
      "type": "string",
      "description": "anthropic | deepseek | fake"
    },
    "costSource": {
      "type": "string",
      "description": "sdk, or harness/prices.json for third-party models"
    },
    "stopReason": {
      "type": [
        "string",
        "null"
      ],
      "description": "SDK result subtype (success, error_max_turns, \u2026) or harness: error_max_budget_usd, error_agent_crash, error_wall_timeout"
    },
    "suite": {
      "enum": [
        "urlshort",
        "actual"
      ]
    },
    "reading": {
      "type": "object",
      "description": "P1 reading precision vs the task's ground-truth relevant files",
      "properties": {
        "filesRead": {
          "type": "integer"
        },
        "readChars": {
          "type": "integer"
        },
        "relevantChars": {
          "type": "integer"
        },
        "coreChars": {
          "type": "integer"
        },
        "precision": {
          "type": "number"
        },
        "coreRecall": {
          "type": "number"
        },
        "readTokens": {
          "type": "integer"
        }
      }
    },
    "crash": {
      "type": "string",
      "description": "agent process error message, if it crashed (run counts as failed)"
    },
    "networkCommandLog": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "flagged Bash commands, first 300 chars each"
    },
    "network": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string",
          "description": "provider-only = agent egress limited to the model API; none = unrestricted"
        },
        "deniedConnections": {
          "type": "integer"
        },
        "denied": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "steering": {
      "type": "object",
      "description": "arm steering: calls redirected to the query layer",
      "properties": {
        "redirects": {
          "type": "integer"
        },
        "byTool": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        }
      }
    },
    "toolCost": {
      "type": "object",
      "description": "per tool: calls, output tokens, carried tokens (output x turns remaining)",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "calls": {
            "type": "integer"
          },
          "outTokens": {
            "type": "integer"
          },
          "carriedTokens": {
            "type": "integer"
          }
        }
      }
    },
    "sdkCostUsd": {
      "type": "number",
      "description": "the SDK's own cost estimate, kept for comparison"
    },
    "bundle": {
      "type": "object",
      "description": "arm D: context bundle in the first prompt",
      "properties": {
        "tokens": {
          "type": "integer"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
