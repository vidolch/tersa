diff --git a/packages/loot-core/src/shared/assert-never.ts b/packages/loot-core/src/shared/assert-never.ts
new file mode 100644
index 0000000..d3047fc
--- /dev/null
+++ b/packages/loot-core/src/shared/assert-never.ts
@@ -0,0 +1,7 @@
+/**
+ * Exhaustiveness check for a `switch` over a closed set: when a new member is added to the set,
+ * every switch that ends in `assertNever` stops compiling until it handles the new member.
+ */
+export function assertNever(x: never, what = 'value'): never {
+  throw new Error(`Unhandled ${what}: ${String(x)}`);
+}
