   }
 };
 
+const MAX_UPCOMING_RANGE_DAYS = 366;
+
+handlers['api/schedules-upcoming-get'] = async function ({ start, end }) {
+  checkFileOpen();
+  validateDay('start date', start);
+  validateDay('end date', end);
+  if (end < start) {
+    throw APIError(`end (${end}) is before start (${start})`);
+  }
+  if (monthUtils.differenceInCalendarDays(end, start) + 1 > MAX_UPCOMING_RANGE_DAYS) {
+    throw APIError(`range is longer than ${MAX_UPCOMING_RANGE_DAYS} days`);
+  }
+
+  const schedules = await handlers['api/schedules-get']();
+  const upcoming = schedules
+    .filter(schedule => !schedule.completed)
+    .flatMap(schedule =>
+      getScheduleDates(schedule.date, { start, end }).map(date => ({
+        scheduleId: schedule.id,
+        name: schedule.name,
+        date,
+        amount: schedule.amount,
+        amountOp: schedule.amountOp,
+        payee: schedule.payee ?? null,
+        account: schedule.account ?? null,
+      })),
+    );
+
+  return upcoming.sort(
+    (a, b) =>
+      a.date.localeCompare(b.date) ||
+      String(a.name ?? '').localeCompare(String(b.name ?? '')) ||
+      a.scheduleId.localeCompare(b.scheduleId),
+  );
+};
+
